# PostgreSQL with pgvector (matches docker-compose.yml defaults).
DATABASE_URL=postgres://normativa:normativa@localhost:5432/normativa

# Optional overrides for docker-compose.yml.
# POSTGRES_USER=normativa
# POSTGRES_PASSWORD=normativa
# POSTGRES_DB=normativa
# POSTGRES_PORT=5432

# Embeddings: a local Ollama server (https://ollama.com) and its model.
# The model must output 1,024 dimensions (see EMBEDDING_DIMENSIONS in src/db/schema.ts).
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3

# Answers: who writes them.
#
# Every provider that is configured below is used, as a chain: when a model
# cannot answer (no capacity, usage limit, not reachable), the next one is
# asked. Hosted providers go first, because they write better; the local model
# goes last, because it is always there.
#
#   gemini             Google's API. Create a free key at
#                      https://aistudio.google.com/apikey. The question and the
#                      chunks are sent to Google.
#   openai-compatible  Any service that speaks OpenAI's API (Groq, OpenRouter,
#                      Cerebras, Mistral...).
#   ollama             A model on the local Ollama. Pull it once:
#                      ollama pull gemma3:4b. Nothing leaves the machine.
#
# To use only some providers, or another order, name them here:
# CHAT_PROVIDER=gemini,ollama

# Gemini. Models are tried in this order; these are the defaults.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash

# An OpenAI-compatible service. For instance, Groq:
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_API_KEY=
# CHAT_MODEL=openai/gpt-oss-120b

# The local model, on the Ollama of OLLAMA_BASE_URL above.
# OLLAMA_CHAT_MODEL=gemma3:4b
