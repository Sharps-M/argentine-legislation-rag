# PostgreSQL with pgvector (matches docker-compose.yml defaults).
DATABASE_URL=postgres://normativa:normativa@localhost:5432/normativa

# Optional overrides for docker-compose.yml.
# POSTGRES_USER=normativa
# POSTGRES_PASSWORD=normativa
# POSTGRES_DB=normativa
# POSTGRES_PORT=5432

# Embeddings: a local Ollama server (https://ollama.com) and its model.
# The model must output 1,024 dimensions (see EMBEDDING_DIMENSIONS in src/db/schema.ts).
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3
